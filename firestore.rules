rules_version = '2';
// Da incollare in Firebase console → Firestore → Regole.
service cloud.firestore {
  match /databases/{db}/documents {
    match /games/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.resource.data.uids == [request.auth.uid]
        && request.resource.data.state == null;
      allow update: if request.auth != null
        && request.resource.data.host == resource.data.host
        && (
          // giocatore della partita: avvia o fa una mossa, senza cambiare chi gioca
          (request.auth.uid in resource.data.uids
            && request.resource.data.uids == resource.data.uids
            && request.resource.data.players == resource.data.players)
          // nuovo giocatore: si aggiunge solo prima dell'avvio
          || (resource.data.state == null
            && resource.data.uids.size() < 5
            && request.resource.data.uids == resource.data.uids.concat([request.auth.uid])
            && request.resource.data.state == null)
        );
      allow delete: if false;
    }
  }
}
